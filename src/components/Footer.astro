---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container row">
    <span>© {year} {profile.name} · {profile.location}{profile.analytics.goatcounter && <> · Cookie-free analytics by <a href="https://www.goatcounter.com" target="_blank" rel="noopener">GoatCounter</a></>}</span>
    <span class="links">
      <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
    </span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--rule); padding-block: 28px calc(28px + env(safe-area-inset-bottom, 0px)); margin-top: 32px; }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); }
  .links { display: flex; gap: 18px; }
  .links a { text-decoration: none; }
</style>
