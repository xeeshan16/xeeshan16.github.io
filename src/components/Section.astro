---
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-label`}>
  <div class="container grid">
    <h2 class="eyebrow rail" id={`${id}-label`}>{label}</h2>
    <div class="body"><slot /></div>
  </div>
</section>

<style>
  section { border-top: 1px solid var(--rule); padding-block: clamp(48px, 7vw, 88px); scroll-margin-top: 60px; }
  .grid { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 20px 48px; }
  .rail { margin: 0; padding-top: 4px; font-weight: 500; }
  .body { min-width: 0; }
  @media (max-width: 820px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
