---
// Renders a high-level architecture diagram from a spec in src/data/architecture.ts.
// Every colour comes from the theme tokens, so it follows light and dark mode.
import type { Diagram, DiagramEdge, Side } from '../data/architecture';

interface Props {
  diagram: Diagram;
  id: string;
  // Compact diagrams sit inline in a write-up: no legend or numbered walkthrough, just an optional caption.
  compact?: boolean;
  caption?: string;
}
const { diagram: d, id, compact = false, caption } = Astro.props;

const WIDTH = 960;
type Box = { x: number; y: number; w: number; h: number };
type Pt = [number, number];

const boxes = new Map<string, Box>();
for (const z of d.zones ?? []) boxes.set(z.id, z);
for (const n of d.nodes) boxes.set(n.id, { x: n.x, y: n.y, w: n.w, h: n.h ?? 56 });

function box(key: string): Box {
  const b = boxes.get(key);
  if (!b) throw new Error(`Diagram "${id}": unknown node "${key}"`);
  return b;
}

function anchor(b: Box, side: Side, t = 0.5): Pt {
  if (side === 'l') return [b.x, b.y + b.h * t];
  if (side === 'r') return [b.x + b.w, b.y + b.h * t];
  if (side === 't') return [b.x + b.w * t, b.y];
  return [b.x + b.w * t, b.y + b.h];
}

function sides(a: Box, b: Box): [Side, Side] {
  if (b.x >= a.x + a.w) return ['r', 'l'];
  if (b.x + b.w <= a.x) return ['l', 'r'];
  if (b.y >= a.y + a.h) return ['b', 't'];
  return ['t', 'b'];
}

const horizontal = (s: Side) => s === 'l' || s === 'r';

function route(e: DiagramEdge): Pt[] {
  const a = box(e.from);
  const b = box(e.to);
  const [autoFrom, autoTo] = sides(a, b);
  const fs = e.fromSide ?? autoFrom;
  const ts = e.toSide ?? autoTo;
  const s = anchor(a, fs, e.fromAt);
  const t = anchor(b, ts, e.toAt);
  if (e.via) return [s, ...e.via, t];
  if (horizontal(fs) && horizontal(ts)) {
    if (s[1] === t[1]) return [s, t];
    const mx = (s[0] + t[0]) / 2;
    return [s, [mx, s[1]], [mx, t[1]], t];
  }
  if (!horizontal(fs) && !horizontal(ts)) {
    if (s[0] === t[0]) return [s, t];
    const my = (s[1] + t[1]) / 2;
    return [s, [s[0], my], [t[0], my], t];
  }
  return horizontal(fs) ? [s, [t[0], s[1]], t] : [s, [s[0], t[1]], t];
}

function labelSpot(pts: Pt[]): Pt {
  let best = 0;
  let spot: Pt = pts[0];
  for (let i = 1; i < pts.length; i++) {
    const [x1, y1] = pts[i - 1];
    const [x2, y2] = pts[i];
    const len = Math.abs(x2 - x1) + Math.abs(y2 - y1);
    if (len > best) {
      best = len;
      spot = [(x1 + x2) / 2, (y1 + y2) / 2];
    }
  }
  return spot;
}

const edges = d.edges.map((e) => {
  const pts = route(e);
  return {
    ...e,
    path: pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' '),
    spot: labelSpot(pts),
  };
});

const nodes = d.nodes.map((n) => {
  const h = n.h ?? 56;
  const subs = n.sub === undefined ? [] : Array.isArray(n.sub) ? n.sub : [n.sub];
  const kind = n.kind ?? 'service';
  const block = 16 + subs.length * 13;
  const top = n.y + h / 2 - block / 2 + (kind === 'store' ? 3 : 0);
  return { ...n, h, subs, kind, titleY: top + 12, subY: (i: number) => top + 28 + i * 13 };
});

const cylinder = (x: number, y: number, w: number, h: number) =>
  `M${x} ${y + 5} a${w / 2} 5 0 0 1 ${w} 0 v${h - 10} a${w / 2} 5 0 0 1 ${-w} 0 z`;
const cylinderLip = (x: number, y: number, w: number) => `M${x} ${y + 5} a${w / 2} 5 0 0 0 ${w} 0`;

const steps = [
  ...(d.zones ?? []).filter((z) => z.step).map((z) => ({ step: z.step!, x: z.x, y: z.y })),
  ...nodes.filter((n) => n.step).map((n) => ({ step: n.step!, x: n.x, y: n.y })),
];
const arrow = `${id}-arrow`;
---
<figure class:list={['arch', { compact }]}>
  <div class="scroll">
    <svg viewBox={`0 0 ${WIDTH} ${d.height}`} role="img" aria-labelledby={`${id}-title`}>
      <title id={`${id}-title`}>{d.title}</title>
      <defs>
        <marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="arrowhead" />
        </marker>
      </defs>

      {(d.zones ?? []).map((z) => (
        <g>
          <rect x={z.x} y={z.y} width={z.w} height={z.h} rx="8" class="zone" />
          <text x={z.x + 14} y={z.y + 19} class="zone-label">{z.label.toUpperCase()}</text>
        </g>
      ))}

      {edges.map((e) => (
        <path
          d={e.path}
          class:list={['edge', { async: e.async }]}
          marker-end={`url(#${arrow})`}
          marker-start={e.both ? `url(#${arrow})` : undefined}
        />
      ))}

      {nodes.map((n) => (
        <g class:list={['node', n.kind]}>
          {n.kind === 'store' ? (
            <>
              <path d={cylinder(n.x, n.y, n.w, n.h)} class="shape" />
              <path d={cylinderLip(n.x, n.y, n.w)} class="lip" />
            </>
          ) : (
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.kind === 'queue' ? 14 : 5} class="shape" />
          )}
          <text x={n.x + n.w / 2} y={n.titleY} class="title">{n.title}</text>
          {n.subs.map((s, i) => <text x={n.x + n.w / 2} y={n.subY(i)} class="sub">{s}</text>)}
        </g>
      ))}

      {edges.filter((e) => e.label).map((e) => {
        const w = e.label!.length * 6.2 + 12;
        return (
          <g>
            <rect x={e.spot[0] - w / 2} y={e.spot[1] - 9} width={w} height="18" rx="3" class="label-bg" />
            <text x={e.spot[0]} y={e.spot[1] + 3.5} class="edge-label">{e.label}</text>
          </g>
        );
      })}

      {steps.map((s) => (
        <g>
          <circle cx={s.x} cy={s.y} r="10" class="badge" />
          <text x={s.x} y={s.y + 3.8} class="badge-num">{s.step}</text>
        </g>
      ))}
    </svg>
  </div>
  <p class="swipe" aria-hidden="true">Scroll sideways to see the whole diagram →</p>

  {compact ? (caption && <figcaption class="plain">{caption}</figcaption>) : (<>
  <ul class="legend" aria-label="Legend">
    <li><svg viewBox="0 0 28 10" width="28" height="10" aria-hidden="true"><path d="M1 5 H27" class="edge" /></svg>Request / call</li>
    <li><svg viewBox="0 0 28 10" width="28" height="10" aria-hidden="true"><path d="M1 5 H27" class="edge async" /></svg>Async event</li>
    <li><svg viewBox="0 0 24 16" width="24" height="16" aria-hidden="true"><rect x="1" y="1" width="22" height="14" rx="7" class="shape lg-queue" /></svg>Stream / queue</li>
    <li><svg viewBox="0 0 20 18" width="20" height="18" aria-hidden="true"><path d={cylinder(1, 1, 18, 16)} class="shape lg-store" /><path d={cylinderLip(1, 1, 18)} class="lip" /></svg>Data store</li>
    <li><svg viewBox="0 0 24 16" width="24" height="16" aria-hidden="true"><rect x="1" y="1" width="22" height="14" rx="3" class="shape lg-ext" /></svg>External system</li>
    <li><svg viewBox="0 0 24 16" width="24" height="16" aria-hidden="true"><rect x="1" y="1" width="22" height="14" rx="3" class="shape lg-accent" /></svg>Key component</li>
  </ul>

  <figcaption>
    <h3 class="eyebrow">How it flows</h3>
    <ol class="steps">
      {d.steps.map((s, i) => <li><span class="num" aria-hidden="true">{i + 1}</span><span>{s}</span></li>)}
    </ol>
  </figcaption>
  </>)}
</figure>

<style>
  .arch.compact { margin: 1.6em 0 1.8em; }
  .arch { margin: 0; background: var(--surface); border-radius: var(--radius); padding: clamp(16px, 3vw, 28px); }
  .scroll { overflow-x: auto; }
  .scroll > svg { display: block; width: 100%; min-width: 760px; height: auto; }
  .swipe { display: none; margin: 8px 0 0; font-size: 0.75rem; color: var(--muted); font-family: var(--font-mono); }
  @media (max-width: 820px) { .swipe { display: block; } }

  .zone { fill: color-mix(in srgb, var(--raised) 55%, transparent); stroke: var(--rule); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .zone-label { font: 500 10.5px var(--font-mono); letter-spacing: 0.1em; fill: var(--muted); }

  .edge { fill: none; stroke: var(--muted); stroke-width: 1.4; }
  .edge.async { stroke-dasharray: 5 4; }
  .arrowhead { fill: var(--muted); }

  .shape { fill: var(--bg); stroke: var(--rule); stroke-width: 1.4; }
  .lip { fill: none; stroke: var(--rule); stroke-width: 1.4; }
  .accent .shape, .lg-accent { fill: var(--accent-soft); stroke: var(--accent); }
  .external .shape, .lg-ext { fill: transparent; stroke: var(--muted); stroke-dasharray: 4 3; }
  .queue .shape, .lg-queue { stroke: var(--fg); stroke-opacity: 0.45; }
  .store .shape, .lg-store { fill: var(--raised); }

  .title { font: 600 13px var(--font-body); fill: var(--fg); text-anchor: middle; }
  .accent .title { fill: var(--accent); }
  .sub { font: 400 10px var(--font-mono); fill: var(--muted); text-anchor: middle; }

  .label-bg { fill: var(--surface); }
  .edge-label { font: 500 10px var(--font-mono); fill: var(--muted); text-anchor: middle; }

  .badge { fill: var(--fg); }
  .badge-num { font: 700 10.5px var(--font-mono); fill: var(--bg); text-anchor: middle; }

  .legend { list-style: none; margin: 18px 0 0; padding: 14px 0 0; border-top: 1px solid var(--rule); display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 0.8125rem; color: var(--muted); }
  .legend li { display: inline-flex; align-items: center; gap: 8px; }

  figcaption { margin-top: 22px; }
  figcaption.plain { margin-top: 12px; font-size: 0.875rem; color: var(--muted); }
  figcaption h3 { margin: 0 0 12px; font-weight: 500; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; max-width: 78ch; }
  .steps li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 12px; align-items: start; font-size: 0.9375rem; }
  .num {
    display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; margin-top: 1px;
    background: var(--fg); color: var(--bg); font: 700 0.6875rem var(--font-mono);
  }
</style>
