---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="container nf">
    <p class="eyebrow">HTTP 404</p>
    <h1>This page doesn't exist.</h1>
    <p>The link may be old, or the address may have a typo.</p>
    <a class="btn btn-primary" href="/">Back to the home page</a>
  </div>
</Base>

<style>
  .nf { padding-block: clamp(64px, 14vw, 160px); display: grid; gap: 16px; justify-items: start; }
  .nf .eyebrow { margin: 0; color: var(--accent); }
  h1 { font-family: var(--font-display); font-variation-settings: 'wdth' 114; font-weight: 780; font-size: var(--step-3); margin: 0; line-height: 1.05; }
  p { margin: 0; color: var(--muted); }
</style>
