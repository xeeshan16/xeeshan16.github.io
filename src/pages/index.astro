---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Metrics from '../components/Metrics.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { profile, highlights, experience, principles, skills, certifications, recognition } from '../data/profile';
import { diagrams } from '../data/architecture';
import { readingMinutes, storyCount } from '../lib/case-study';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured);
const more = work.filter((w) => !w.data.featured);
const extras = (w: (typeof work)[number]) => {
  const n = storyCount(w.body);
  return [
    diagrams[w.id] && 'Architecture diagram',
    n > 0 && `${n} production ${n === 1 ? 'story' : 'stories'}`,
    `${readingMinutes(w.body)} min read`,
  ].filter(Boolean) as string[];
};
const hasCv = fs.existsSync(path.join(process.cwd(), 'public', profile.cvFile));
---
<Base>
  <div class="hero">
    <div class="container">
      <p class="status"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
      <p class="eyebrow who">{profile.name} · {profile.role} · {profile.location}</p>
      <h1>{profile.headline}</h1>
      <p class="intro">{profile.intro}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#work">See selected work</a>
        {hasCv && <a class="btn" href={`/${profile.cvFile}`} download data-goatcounter-click="cv-download-hero" data-goatcounter-title="CV download (hero)"><span aria-hidden="true">↓</span> Download CV</a>}
        <a class="btn" href="#contact">Get in touch</a>
        <a class="btn btn-ghost" href={profile.links.linkedin} target="_blank" rel="noopener" data-goatcounter-click="linkedin-hero" data-goatcounter-title="LinkedIn (hero)">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="container highlights">
      <Metrics items={highlights} size="lg" />
    </div>
  </div>

  <Section id="work" label="Selected work">
    <div class="featured">
      {featured.map((w, i) => (
        <a class="feature" href={`/work/${w.id}/`}>
          <div class="feature-main">
            <p class="eyebrow card-meta"><span class="idx">{String(i + 1).padStart(2, '0')}</span>{w.data.company} · {w.data.area}</p>
            <h3>{w.data.title}</h3>
            <p class="card-summary">{w.data.summary}</p>
            <p class="extras">{extras(w).join(' · ')}</p>
            <span class="read">Read the case study <span aria-hidden="true">→</span></span>
          </div>
          <div class="feature-side">
            {w.data.metrics.length > 0 && (
              <dl class="feature-metrics">
                {w.data.metrics.slice(0, 3).map((m) => (
                  <div><dd>{m.value}</dd><dt>{m.label}</dt></div>
                ))}
              </dl>
            )}
            {w.data.role && (
              <p class="feature-role">
                <span class="eyebrow">My role</span>
                {w.data.role.title}{w.data.role.team && <><br />{w.data.role.team}</>}
              </p>
            )}
          </div>
        </a>
      ))}
    </div>

    <h3 class="eyebrow more-label">More work</h3>
    <ul class="more">
      {more.map((w, i) => (
        <li>
          <a href={`/work/${w.id}/`}>
            <span class="more-idx">{String(featured.length + i + 1).padStart(2, '0')}</span>
            <span class="more-main">
              <span class="eyebrow more-meta">{w.data.company} · {w.data.area}</span>
              <span class="more-title">{w.data.title}</span>
            </span>
            <span class="more-metric">
              {w.data.metrics[0] ? <><b>{w.data.metrics[0].value}</b> {w.data.metrics[0].label}</> : (w.data.highlight ?? w.data.summary)}
            </span>
            <span class="more-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="experience" label="Experience">
    <ol class="roles">
      {experience.map((r, i) => (
        <li class:list={{ current: i === 0 }}>
          <span class="node" aria-hidden="true"></span>
          <p class="when">{r.period}{r.note && <span> · {r.note}</span>}</p>
          <h3>{r.company}</h3>
          <p class="role-title">{r.title}</p>
          <p class="role-summary">{r.summary}</p>
          <ul class="chips">{r.stack.map((t) => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="approach" label="How I work">
    <div class="principles">
      {principles.map((p) => (
        <div>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section id="skills" label="Toolbox">
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt class="eyebrow">{s.group}</dt>
          <dd>{s.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="certifications" label="Certifications">
    <ul class="certs">
      {certifications.map((c) => {
        const inner = (
          <>
            <span class="cert-top">
              <span class="eyebrow cert-issuer">{c.issuer}</span>
              <span class="cert-year">{c.year}</span>
            </span>
            <span class="cert-name">{c.name}</span>
            {(c.code || c.url) && (
              <span class="cert-foot">
                {c.code && <span class="cert-code">{c.code}</span>}
                {c.url && <span class="cert-verify">Verify <span aria-hidden="true">↗</span></span>}
              </span>
            )}
          </>
        );
        return (
          <li>
            {c.url
              ? <a class="cert" href={c.url} target="_blank" rel="noopener">{inner}</a>
              : <div class="cert">{inner}</div>}
          </li>
        );
      })}
    </ul>
  </Section>

  <Section id="recognition" label="Recognition">
    <div class="recog">
      <div>
        <h3 class="eyebrow">Data structures &amp; algorithms</h3>
        <ul>
          {recognition.competitive.map((c) => <li><b class="num">{c.value}</b> {c.text}</li>)}
        </ul>
        <a class="profile-link" href={profile.links.leetcode} target="_blank" rel="noopener">LeetCode profile <span aria-hidden="true">↗</span></a>
      </div>
      <div>
        <h3 class="eyebrow">Education</h3>
        <ul>
          <li>{recognition.education.degree}</li>
          <li class="muted">{recognition.education.school}, {recognition.education.year}</li>
        </ul>
      </div>
    </div>
  </Section>

  <Section id="contact" label="Contact">
    <h2 class="contact-h">Hiring for backend or AI platform work? I'd like to hear about it.</h2>
    <p class="contact-sub">Based in {profile.location}. Open to roles in {profile.regions}.</p>
    <div class="channels">
      <div class="channel"><span class="eyebrow">Email</span><CopyEmail email={profile.email} /></div>
      <div class="channel"><span class="eyebrow">LinkedIn</span><a href={profile.links.linkedin} target="_blank" rel="noopener" data-goatcounter-click="linkedin-contact" data-goatcounter-title="LinkedIn (contact)">linkedin.com/in/zeeshan-imdad</a></div>
      <div class="channel"><span class="eyebrow">GitHub</span><a href={profile.links.github} target="_blank" rel="noopener">github.com/xeeshan16</a></div>
      {hasCv && <div class="channel"><span class="eyebrow">CV</span><a href={`/${profile.cvFile}`} download data-goatcounter-click="cv-download-contact" data-goatcounter-title="CV download (contact)">Download PDF <span aria-hidden="true">↓</span></a></div>}
      <div class="channel"><span class="eyebrow">LeetCode</span><a href={profile.links.leetcode} target="_blank" rel="noopener">leetcode.com/u/zeeshan_16</a></div>
    </div>
  </Section>
</Base>

<style>
  .hero { position: relative; isolation: isolate; padding-block: clamp(48px, 9vw, 112px) clamp(48px, 7vw, 80px); }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: radial-gradient(color-mix(in srgb, var(--fg) 14%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 65% at 75% 30%, #000 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 65% at 75% 30%, #000 10%, transparent 75%);
  }
  .status { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 28px; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--fg); border: 1px solid var(--rule); border-radius: 999px; padding: 5px 14px 5px 10px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #2f9e5b; box-shadow: 0 0 0 4px color-mix(in srgb, #2f9e5b 20%, transparent); }
  .who { margin: 0 0 16px; }
  h1 {
    font-family: var(--font-display); font-variation-settings: 'wdth' 116; font-weight: 780;
    font-size: var(--step-4); line-height: 0.98; letter-spacing: -0.025em; margin: 0; max-width: 16ch;
  }
  .intro { font-size: var(--step-1); max-width: 62ch; margin: 28px 0 0; color: var(--fg); }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .highlights { margin-top: clamp(48px, 7vw, 72px); }

  .featured { display: grid; gap: 16px; }
  .feature {
    display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 32px;
    padding: clamp(22px, 3vw, 32px); border: 1px solid var(--rule); border-radius: var(--radius); background: var(--raised);
    text-decoration: none; position: relative; overflow: hidden;
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .feature::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--accent); }
  .feature:hover { border-color: var(--accent); color: inherit; transform: translateY(-2px); box-shadow: 0 10px 30px -18px color-mix(in srgb, var(--fg) 45%, transparent); }
  @media (max-width: 820px) { .feature { grid-template-columns: minmax(0, 1fr); gap: 20px; } }
  .feature-main { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .card-meta { margin: 0; color: var(--accent); display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .idx { color: var(--muted); }
  .feature h3 { font-family: var(--font-display); font-variation-settings: 'wdth' 110; font-weight: 750; font-size: var(--step-3); line-height: 1.04; margin: 0; letter-spacing: -0.015em; }
  .card-summary { margin: 0; color: var(--muted); max-width: 60ch; }
  .extras { margin: 2px 0 0; font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); }
  .read { margin-top: auto; padding-top: 10px; font-weight: 600; font-size: 0.9375rem; }
  .feature:hover .read { color: var(--accent); }
  .feature-side { display: flex; flex-direction: column; justify-content: center; gap: 22px; padding-left: 28px; border-left: 1px solid var(--rule); }
  .feature-metrics { margin: 0; display: grid; gap: 16px; }
  .feature-role { margin: 0; display: grid; gap: 4px; font-size: 0.875rem; font-weight: 500; line-height: 1.4; padding-top: 18px; border-top: 1px dashed var(--rule); }
  @media (max-width: 820px) {
    .feature-side { padding: 18px 0 0; border-left: 0; border-top: 1px solid var(--rule); }
    .feature-metrics { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); }
  }
  .feature-metrics div { display: grid; gap: 2px; align-content: start; }
  .feature-metrics dd { margin: 0; font-family: var(--font-display); font-variation-settings: 'wdth' 100; font-weight: 750; font-size: 1.875rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .feature-metrics dt { font-size: 0.8125rem; color: var(--muted); line-height: 1.35; }

  .more-label { margin: 44px 0 6px; font-weight: 500; }
  .more { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .more li { border-bottom: 1px solid var(--rule); }
  .more a {
    display: grid; grid-template-columns: 34px minmax(0, 1fr) minmax(0, 250px) 20px; align-items: center; gap: 4px 20px;
    padding: 18px 8px; text-decoration: none; transition: background-color .15s;
  }
  .more a:hover { background: var(--raised); color: inherit; }
  .more-idx { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); }
  .more-main { display: grid; gap: 2px; min-width: 0; }
  .more-meta { color: var(--accent); }
  .more-title { font-family: var(--font-display); font-variation-settings: 'wdth' 106; font-weight: 700; font-size: 1.1875rem; line-height: 1.2; }
  .more-metric { font-size: 0.875rem; color: var(--muted); line-height: 1.35; }
  .more-metric b { font-family: var(--font-display); color: var(--fg); font-variant-numeric: tabular-nums; }
  .more-arrow { color: var(--muted); transition: transform .15s, color .15s; }
  .more a:hover .more-arrow { color: var(--accent); transform: translateX(3px); }
  @media (max-width: 700px) {
    .more a { grid-template-columns: 28px minmax(0, 1fr) 20px; }
    .more-metric { grid-column: 2; grid-row: 2; }
    .more-arrow { grid-row: 1; grid-column: 3; }
  }

  .roles { list-style: none; margin: 0; padding: 0; display: grid; }
  .roles > li { position: relative; padding: 0 0 36px 32px; }
  .roles > li:last-child { padding-bottom: 0; }
  .roles > li::before { content: ''; position: absolute; left: 5px; top: 10px; bottom: -10px; width: 1px; background: var(--rule); }
  .roles > li:last-child::before { display: none; }
  .node { position: absolute; left: 0; top: 6px; width: 11px; height: 11px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--muted); }
  .current .node { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .when { margin: 0 0 4px; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--muted); }
  .current .when { color: var(--accent); }
  .roles h3 { font-family: var(--font-display); font-variation-settings: 'wdth' 106; font-weight: 700; font-size: 1.375rem; line-height: 1.2; margin: 0; }
  .role-title { margin: 2px 0 0; font-weight: 500; }
  .role-summary { margin: 10px 0 14px; color: var(--muted); max-width: 68ch; }

  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  @media (max-width: 900px) { .principles { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  .principles h3 { font-family: var(--font-display); font-variation-settings: 'wdth' 106; font-weight: 680; font-size: 1.1875rem; margin: 0 0 8px; }
  .principles p { margin: 0; color: var(--muted); }

  .skills { margin: 0; display: grid; }
  .skills > div {
    display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 6px 32px; align-items: baseline;
    padding-block: 16px; border-top: 1px solid var(--rule);
  }
  .skills > div:first-child { border-top: 0; padding-top: 0; }
  @media (max-width: 640px) { .skills > div { grid-template-columns: minmax(0, 1fr); } }
  .skills dt { color: var(--accent); }
  .skills dd { margin: 0; font-size: 0.9375rem; line-height: 1.6; }

  .certs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 1100px) { .certs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .certs { grid-template-columns: minmax(0, 1fr); } }
  .certs li { display: flex; min-width: 0; }
  .cert {
    flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0;
    padding: 16px 18px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--raised); text-decoration: none;
  }
  a.cert:hover { border-color: var(--accent); color: inherit; }
  .cert-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .cert-issuer { color: var(--accent); }
  .cert-year { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); }
  .cert-name { font-weight: 600; line-height: 1.35; }
  .cert-foot { margin-top: auto; padding-top: 6px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 12px; }
  .cert-code { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); }
  .cert-verify { margin-left: auto; font-size: 0.8125rem; font-weight: 600; color: var(--accent); white-space: nowrap; }

  .recog { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 40px; }
  @media (max-width: 700px) { .recog { grid-template-columns: minmax(0, 1fr); } }
  .recog h3 { margin: 0 0 10px; font-weight: 500; }
  .recog ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 0.9375rem; }
  .muted { color: var(--muted); }
  .num { font-family: var(--font-display); font-weight: 700; font-variant-numeric: tabular-nums; }
  .profile-link { display: inline-block; margin-top: 12px; font-size: 0.9375rem; font-weight: 600; text-decoration: none; }

  .contact-h { font-family: var(--font-display); font-variation-settings: 'wdth' 114; font-weight: 750; font-size: var(--step-3); line-height: 1.05; letter-spacing: -0.015em; margin: 0; max-width: 22ch; }
  .contact-sub { color: var(--muted); margin: 14px 0 0; }
  .channels { display: grid; gap: 14px; margin-top: 28px; }
  .channel { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; min-width: 0; font-family: var(--font-mono); font-size: 0.9375rem; }
  .channel .eyebrow { width: 84px; flex: none; }
  .channel a { overflow-wrap: anywhere; }
</style>
